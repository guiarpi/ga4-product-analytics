{#- data-v = the raw value each cell sorts on (the table is sortable in the browser). -#}
{% for r in category_rows -%}
<tr><td class="dev-name" data-v="{{ r.item_category }}">{{ r.item_category }}{% if r.n_source_labels > 1 %}<div style="font-size:0.7rem;font-weight:400;color:#9ca3af">merged: {{ r.source_labels }}</div>{% endif %}</td><td data-v="{{ r.viewing_sessions }}">{{ r.viewing_sessions|int|fmt(',') }}</td><td data-v="{{ r.carting_sessions }}">{{ r.carting_sessions|int|fmt(',') }}</td><td class="dev-key" data-v="{{ r.atc_pct }}">{{ r.atc_pct|fmt('.1f') }}%</td><td class="ci" data-v="{{ r.ci_lo }}">{{ r.ci_lo|fmt('.1f') }}–{{ r.ci_hi|fmt('.1f') }}%</td><td data-v="{{ {'below': 0, 'neutral': 1, 'above': 2}[r.status] }}">{% if r.status == "below" %}<span class="flag-below">below</span>{% elif r.status == "above" %}<span class="flag-above">above</span>{% else %}<span class="flag-neutral">≈ average</span>{% endif %}</td><td data-v="{{ r.carts_at_stake }}">{{ r.carts_at_stake|int|fmt(',') }}</td></tr>
{% endfor %}
