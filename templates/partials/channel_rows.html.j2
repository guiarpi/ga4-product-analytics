{#- data-v = the raw value each cell sorts on (the table is sortable in the browser). -#}
{% for r in channel_rows -%}
<tr><td class="dev-name" data-v="{{ r.channel }}">{{ r.channel }}</td><td data-v="{{ r.sessions }}">{{ r.sessions|int|fmt(',') }}</td><td data-v="{{ r.share }}">{{ r.share|fmt('.1f') }}%</td><td class="dev-key" data-v="{{ r.view_pct }}">{{ r.view_pct|fmt('.1f') }}%</td><td data-v="{{ r.cart_from_view if r.cart_from_view is not none else -1 }}">{% if r.cart_from_view is none %}—{% else %}{{ r.cart_from_view|fmt('.1f') }}%{% endif %}</td><td data-v="{{ r.purch_pct }}">{{ r.purch_pct|fmt('.2f') }}%{% if r.low_n %} <span title="fewer than 30 purchases">*</span>{% endif %}</td><td data-v="{{ r.rev_per_session }}">${{ r.rev_per_session|fmt(',.2f') }}</td></tr>
{% endfor %}
