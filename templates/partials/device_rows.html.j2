{% for r in device_rows -%}
<tr><td class="dev-name">{{ r.device_category|capitalize }}</td><td>{{ r.sessions|int|fmt(',') }}</td><td>{{ r.share|fmt('.1f') }}%</td><td>{{ r.view_pct|fmt('.1f') }}%</td><td>{{ r.cart_pct|fmt('.1f') }}%</td><td class="dev-key">{{ r.purch_pct|fmt('.2f') }}%</td><td class="ci">{{ r.ci[0]|fmt('.2f') }}–{{ r.ci[1]|fmt('.2f') }}%</td></tr>
{% endfor %}
