{#- dashboard.html.j2 — the page generate_dashboard.py renders.
    Autoescaped: every {{ value }} is HTML-escaped unless marked |safe (charts,
    plotly.js, the rendered brief). |fmt(spec) formats a number like Python's
    format(value, spec); |pval formats a p-value. Narrative fragments with
    their own logic live in partials/.

    Order follows the questions a stakeholder asks, answer first: the headline
    and KPIs, where the funnel leaks, whether it is the traffic, the device or
    the catalogue, whether visitors come back, what to do, then an appendix.
    Section numbers are shared with the notebook and the README (1 setup and
    data, 2 data quality, 3–8 the questions, 9 the AI brief). -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GA4 Funnel Analysis — Product Dashboard</title>
<!-- plotly.js is embedded (not loaded from a CDN) so the file works offline and
     the JS version always matches the Python plotly package that built the figures. -->
<script type="text/javascript">{{ plotly_js|safe }}</script>
<style>
{% include "dashboard.css" %}
</style>
</head>
<body>

<div class="page-header">
  <h1>GA4 E-Commerce — Product Funnel Analysis</h1>
  <div class="subtitle">
    <span>Session-scoped · Sequential conversion</span>
    <span>{{ date_label }}</span>
    <span>GA4 public e-commerce sample · BigQuery</span>
    <span>Generated {{ generated_date }}</span>
  </div>
</div>

<!-- Sticky section menu: plain anchors, so it works with JavaScript off. -->
<nav class="section-nav" aria-label="Sections">
  <a href="#leak">Funnel</a><a href="#traffic">Traffic</a><a href="#device">Device</a><a href="#catalogue">Catalogue</a><a href="#retention">Retention</a><a href="#actions">Actions</a><a href="#appendix">Appendix</a>
</nav>

<div class="container">

  <!-- ── 1 · The answer ─────────────────────────────────────────────────── -->
  <div class="exec-card">
    <div class="priority-tag">Primary bottleneck: {{ priority_label }}</div>
    <p>{% include "partials/exec_summary.html.j2" %}</p>
  </div>

  <div class="kpi-grid">
    <div class="kpi">
      <div class="kpi-label">Sessions</div>
      <div class="kpi-value">{{ total_sessions|fmt(',') }}</div>
      <div class="kpi-sub">{{ unique_users|fmt(',') }} users · {{ (total_sessions / unique_users)|fmt('.1f') }} sessions each</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">Session → Purchase</div>
      <div class="kpi-value">{{ overall_cvr|fmt('.2f') }}%</div>
      <div class="kpi-sub">{{ purchase_n|fmt(',') }} purchases, every step in order</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">Revenue</div>
      <div class="kpi-value">${{ total_revenue|fmt(',.0f') }}</div>
      <div class="kpi-sub">funnel purchases · AOV ${{ aov|fmt(',.2f') }}, median ${{ median_order|fmt(',.0f') }}</div>
    </div>
    <div class="kpi {{ ('warn' if wk1_warn else '') }}">
      <div class="kpi-label">Next-week return {{ retention_flag }}</div>
      <div class="kpi-value">{{ wk1_display }}</div>
      <div class="kpi-sub">average of {{ wk1_n_cohorts }} weekly cohorts{% if has_retention_trend and trend_peak.month != trend_trough.month %} · {{ trend_peak.month }} {{ trend_peak.lo|fmt('.0f') }}–{{ trend_peak.hi|fmt('.0f') }}%, {{ trend_trough.month }} {{ trend_trough.lo|fmt('.0f') }}–{{ trend_trough.hi|fmt('.0f') }}%{% endif %}</div>
    </div>
  </div>

{% include "partials/dq_callout.html.j2" %}

  <!-- ── 2 · Where does the funnel leak? ────────────────────────────────── -->
  <p class="section-label" id="leak">3 · Where does the funnel leak?</p>
  <div class="card">
    <div class="chart-insight">
      <div>
        <h3 class="chart-title">{% if disc_is_biggest %}{{ (100 - view_rate)|fmt('.0f') }}% of sessions never see a product, and {{ cart_abandon_pct|fmt('.0f') }}% of carts are abandoned before checkout{% else %}The largest loss is {{ biggest_drop_step }} → next step ({{ biggest_drop_n|fmt(',') }} sessions){% endif %}</h3>
        <p class="chart-hint">The menu switches the funnel to one segment; the title and the tables describe all sessions.</p>
        {{ charts.funnel|safe }}
      </div>
      <div>
        <div class="insight-panel">
          <h4>Losses, largest first</h4>
          <table class="dev-table loss-table">
            <thead><tr><th>Step</th><th>Lost</th><th>Drop-off</th></tr></thead>
            <tbody>
{% for r in step_losses -%}
<tr><td class="dev-name">{{ r.from }} → {{ r.to }}</td><td>{{ r.lost|fmt(',') }}</td><td class="dev-key">{{ r.drop_pct|fmt('.1f') }}%</td></tr>
{% endfor %}
            </tbody>
          </table>
          <p style="margin-top:12px"><strong>Sequential</strong>: a session counts at a step only if it
          completed every earlier step in order, within the same session, as a closed funnel does in GA4.
          {% if disc_is_biggest %}Discovery is the largest loss by far. {% endif %}{{ cart_abandon_pct|fmt('.0f') }}% of carts never reach
          checkout{{ (', the largest loss once a shopper has shown purchase intent' if (cart_abandon_pct > (100 - checkout_to_purch)) else '') }}.</p>
        </div>
        {#- Initial values are rendered here (same arithmetic as the script below), so
            the box reads correctly with JavaScript off. -#}
        {% set _lift, _keep = 5, 75 %}
        {% set _views = (total_sessions * _lift / 100)|int %}
        {% set _orders = (_views * view_to_purchase_rate)|round|int %}
        {% set _rev = (_orders * rev_per_purchase)|round %}
        <div class="opportunity calc" id="calc" data-sessions="{{ total_sessions }}" data-vtp="{{ view_to_purchase_rate }}"
             data-rpp="{{ rev_per_purchase }}" data-view="{{ view_rate }}">
          <h4>Revenue opportunity calculator</h4>
          <label class="calc-row">Sessions that see a product: +<output id="calc-lift-out">{{ _lift }}</output>pp
            (<span id="calc-view">{{ view_rate|fmt('.1f') }}% → {{ (view_rate + _lift)|fmt('.1f') }}%</span>)
            <input type="range" id="calc-lift" min="1" max="15" step="1" value="{{ _lift }}"></label>
          <label class="calc-row">Added sessions convert at <output id="calc-keep-out">{{ _keep }}</output>% of today's
            {{ (view_to_purchase_rate * 100)|fmt('.1f') }}% saw-products → purchase rate
            <input type="range" id="calc-keep" min="25" max="100" step="5" value="{{ _keep }}"></label>
          <span class="big-number" id="calc-orders">~{{ (_orders * _keep / 100)|round|int|fmt(',') }} extra orders</span>
          <p id="calc-rev">~<strong>${{ (_rev * _keep / 100)|round|fmt(',.0f') }}</strong> at ${{ rev_per_purchase|fmt(',.2f') }} per funnel
          purchase. Planning range at 50–100% of today's rate: <strong>${{ (_rev * 0.5)|round|fmt(',.0f') }}–${{ _rev|fmt(',.0f') }}</strong>.</p>
          <p class="calc-note">Marginal traffic usually converts below today's average, so 100% is an upper bound.</p>
        </div>
      </div>
    </div>
    <p class="caveat-note section-note"><strong>Time to convert.</strong> Sessions that buy take a median
    {{ total_ttc_min|fmt('.0f') }} minutes from session start to purchase ({{ ttc_minutes[2]|fmt('.1f') }} min cart → checkout,
    {{ ttc_minutes[3]|fmt('.1f') }} min checkout → purchase); that describes buyers, not why carts are abandoned.
    The saw-products → cart gap is partly a tracking signal, not behaviour: {{ cart_same_ts_pct|fmt('.0f') }}% of carting
    sessions ({{ cart_same_ts|fmt(',') }} of {{ carting_all|fmt(',') }}) log their first add-to-cart at the exact
    microsecond of their first product impression, and {{ cart_no_view|fmt(',') }} carts come before or without one —
    quick-add buttons on listings firing both events at once.</p>
  </div>

  <!-- ── 3 · Is it the traffic? ─────────────────────────────────────────── -->
  <p class="section-label" id="traffic">4 · Is it the traffic? Acquisition channels</p>
  <div class="card">
    <div class="chart-insight">
      <div>
        <h3 class="chart-title">{% if channel_is_driver %}Product reach varies by {{ channel_view_spread|fmt('.1f') }}pp across channels{% else %}Every channel loses at least {{ (100 - best_view_pct)|fmt('.0f') }}% of sessions before a product <span class="muted">· {{ channel_view_spread|fmt('.1f') }}pp spread, under the 10pp threshold</span>{% endif %}</h3>
        {{ charts.channel|safe }}
      </div>
      <div class="insight-panel">
        <h4>Conclusion</h4>
        {% include "partials/channel_verdict.html.j2" %}
        <details class="caveat"><summary>How channel is defined</summary>
        <p class="caveat-note">{% include "partials/channel_basis_note.html.j2" %} The public sample obfuscates
        some values (<code>&lt;Other&gt;</code>, <code>(data deleted)</code>);
        they are kept as reported rather than guessed.</p></details>
      </div>
    </div>
    <table class="dev-table sortable" style="margin-top:20px">
      <thead>
        <tr>
          <th>Channel</th><th>Sessions</th><th>Share</th><th>Saw Product</th>
          <th>Saw → Cart</th><th>Purchase</th><th>Rev / Session</th>
        </tr>
      </thead>
      <tbody>
{% include "partials/channel_rows.html.j2" %}
      </tbody>
    </table>
    <p class="table-note">
      * fewer than 30 purchases — the <em>purchase</em> and revenue columns are too
      noisy to compare. View-item rates rest on session counts and are unaffected.
      Channels under 1% of sessions are grouped.</p>
  </div>

  <!-- ── 4 · Is it the device? ──────────────────────────────────────────── -->
  <p class="section-label" id="device">5 · Is it the device?</p>
  <div class="card">
    <p class="lead"><strong>No.</strong> Session-to-purchase rates differ by
    <strong>{{ device_gap|fmt('.2f') }}pp</strong> across desktop, mobile and tablet
    (χ² {{ device_test.p|pval }}{{ (", significant but negligible, Cramér's V = " ~ device_test['cramers_v']|fmt('.3f')) if device_significant else ', no evidence of a difference' }}).
    A mobile-first redesign would not move the number.</p>
    <table class="dev-table" style="margin-top:14px">
      <thead>
        <tr>
          <th>Device</th><th>Sessions</th><th>Share</th>
          <th>Saw Product</th><th>Add to Cart</th><th>Purchase</th><th>95% CI</th>
        </tr>
      </thead>
      <tbody>
{% include "partials/device_rows.html.j2" %}
      </tbody>
    </table>
  </div>

  <!-- ── 5 · Where in the catalogue? ────────────────────────────────────── -->
  <p class="section-label" id="catalogue">6 · Where in the catalogue? Listing pages and price</p>
  <div class="card">
    <p class="lead">Each row is a <strong>listing page</strong> a product was shown in, not a fixed product
    category: {{ overlap_multi|fmt(',') }} of {{ overlap_items|fmt(',') }} products appear under more than one{% if overlap_example %}
    (the most-seen of them, {{ overlap_example.item }}, under {{ overlap_example.n }}: {{ overlap_example.categories|join(', ') }}){% endif %}.
    Product-type pages are ranked against each other; brand, collection and parent pages mix product
    types, so they are shown separately.</p>
    <div class="chart-insight">
      <div>
        <h3 class="chart-title">{% if category_n_below %}{{ category_n_below }} of {{ n_categories }} product-type pages cart below the {{ category_benchmark|fmt('.1f') }}% average <span class="muted">· most carts at stake at the top</span>{% else %}No product-type page carts clearly below the {{ category_benchmark|fmt('.1f') }}% average{% endif %}</h3>
        {{ charts.category|safe }}
      </div>
      <div class="insight-panel">
        <h4>Where to start the merchandising audit</h4>
        {% include "partials/category_verdict.html.j2" %}
        {% include "partials/category_price_note.html.j2" %}
      </div>
    </div>
    <table class="dev-table sortable" style="margin-top:20px">
      <thead>
        <tr>
          <th>Product-type page</th><th>Sessions that saw it</th><th>Carting sessions</th>
          <th>Seen → Carted</th><th>95% CI</th><th>vs average</th><th>Carts at stake</th>
        </tr>
      </thead>
      <tbody>
{% include "partials/category_rows.html.j2" %}
      </tbody>
    </table>

    <div class="two-col sub-block">
      <div>
        <h4 class="sub-h">Brand, collection and parent pages · not ranked</h4>
        <table class="dev-table">
          <thead><tr><th>Page</th><th>Level</th><th>Saw it</th><th>Seen → Carted</th><th>95% CI</th></tr></thead>
          <tbody>
{% for r in listing_other_rows -%}
<tr><td class="dev-name">{{ r.item_category }}</td><td class="level">{{ r.level }}</td><td>{{ r.viewing_sessions|int|fmt(',') }}</td><td class="dev-key">{{ r.atc_pct|fmt('.1f') }}%</td><td class="ci">{{ r.ci[0]|fmt('.1f') }}–{{ r.ci[1]|fmt('.1f') }}%</td></tr>
{% endfor %}
          </tbody>
        </table>
      </div>
      <div>
        <h4 class="sub-h">By the product's price · a real product attribute</h4>
        <h3 class="chart-title">Items at {{ price_best_band }} are carted most, {{ price_worst_band }} least</h3>
        {{ charts.price|safe }}
        <p class="table-note">Items at <strong>{{ price_best_band }}</strong> are carted most ({{ price_best_pct|fmt('.1f') }}%),
        items at <strong>{{ price_worst_band }}</strong> least ({{ price_worst_pct|fmt('.1f') }}%; χ² {{ price_band_test.p|pval }}).
        A session sees items in several bands, so bands are not additive.</p>
      </div>
    </div>
    <details class="caveat section-note"><summary>How the catalogue figures are counted</summary>
    <p class="caveat-note">A session "saw" a page's products when one appeared in a viewed
    product list. It counts as carted only if the item actually carted (the one with a quantity, not the
    rest of the list) is from that page and was carted after the first sighting, so rates are stricter than
    the {{ shoppers_atc|fmt('.0f') }}% shoppers figure. Pages with fewer than {{ MIN_CATEGORY_VIEWS|fmt(',') }}
    viewing sessions ({{ category_excluded_n }} excluded) and <code>(not set)</code>
    ({{ category_notset_share|fmt('.1f') }}% of views) are not shown. Labels are normalised to their last path
    segment (<code>Lifestyle/Bags/</code> → <code>Bags</code>): {{ category_raw_labels }} raw labels collapse into
    {{ (category_raw)|length }}, {{ category_merged_groups }} merged from more than one; the level comes from the
    segment above (Hats under Apparel is a product type, Google under Shop by Brand a brand, Sale under the store
    root a collection).</p></details>
  </div>

  <!-- ── 6 · Do they come back? ─────────────────────────────────────────── -->
  <p class="section-label" id="retention">7 · Do they come back? Weekly cohort retention</p>
  <div class="card">
    <div class="chart-insight flip">
      <div class="insight-panel">
        <h4>What this shows</h4>
        <p>Each row is the users whose <em>first ever session</em> fell in that week; cells show the
        share with a session in each later calendar week. <strong>Next-week return</strong> is {{ WK1_DEFINITION }}.</p>
        <p>Average Week-1 return <strong>{{ wk1_display }}</strong>, Week 2
        <strong>{{ ((avg_wk2 ~ '%') if avg_wk2 else '—') }}</strong>{% if wk1_warn %}, {{ (WK1_TARGET - avg_wk1)|fmt('.1f') }}pp below
        the {{ WK1_TARGET|fmt('.0f') }}% planning target (an assumption, not a benchmark){% endif %}.</p>
        {% include "partials/retention_trend.html.j2" %}
        <details class="caveat"><summary>Two boundary effects in the cohorts</summary>
        {% include "partials/partial_cohort_note.html.j2" %}
        <p><strong>2 · Recent cohorts are right-censored.</strong> A user who joined in the final week has
        not had the chance to return, so those cells are <strong>blank, not 0%</strong>.</p></details>
      </div>
      <div>
        <h3 class="chart-title">{% if has_retention_trend and trend_peak.month != trend_trough.month %}Week-1 return fell from {{ trend_peak.lo|fmt('.0f') }}–{{ trend_peak.hi|fmt('.0f') }}% in {{ trend_peak.month }} cohorts to {{ trend_trough.lo|fmt('.0f') }}–{{ trend_trough.hi|fmt('.0f') }}% in {{ trend_trough.month }}{% else %}{{ wk1_display }} of a weekly cohort returns the next week{% endif %} <span class="muted">· % of each cohort with a session in each later week</span></h3>
        {{ charts.cohort|safe }}
      </div>
    </div>
  </div>

{% include "partials/new_vs_returning.html.j2" %}

  <!-- ── 7 · What should we do? ─────────────────────────────────────────── -->
  <p class="section-label" id="actions">8 · What should we do?</p>
{% include "partials/recommendations.html.j2" %}

  <!-- ── 8 · Appendix ───────────────────────────────────────────────────── -->
  <p class="section-label" id="appendix">Appendix</p>

  <details class="card appendix" id="appendix-data-quality">
    <summary>2 · Data quality, full checks <span class="appendix-sub">untagged sessions, what view_item records, which revenue is counted</span></summary>
    <div class="appendix-body">
{% include "partials/data_quality.html.j2" %}
    </div>
  </details>

  <details class="card appendix">
    <summary>Methodology <span class="appendix-sub">session grain, the sequential rule, statistics</span></summary>
    <div class="appendix-body prose">
      <p><strong>Session-scoped funnel.</strong> Each row is a unique (<code>user_pseudo_id</code>,
      <code>ga_session_id</code>) pair from <code>event_params</code>. A session counts at step N only if it
      reached step N−1 first within the same session. This matches a closed funnel in the GA4 UI and avoids
      crediting a purchase to a session that never carted; the cost is that purchases whose cart was filled in
      an earlier session are not counted (see Data quality).</p>
      <p><strong>Channel</strong> is the session's own <code>medium</code> from <code>event_params</code>, not
      <code>traffic_source.medium</code>, which is the user's first touch repeated on every later session. A
      10pp spread in product reach is the decision threshold; 7–10pp is reported as borderline.</p>
      <p><strong>Statistics.</strong> Rates carry Wilson 95% intervals; group differences are tested with
      chi-square and sized with Cramér's V. A listing page is flagged only when its whole interval lies on one
      side of the average. Medians are exact (<code>PERCENTILE_CONT</code>), so every run gives the same page.</p>
      <p><strong>Retention.</strong> Monday-anchored weekly cohorts by first session in the window;
      right-censored cells are blank, and a partial first week is excluded from the averages. The retention
      trend splits a change in Week-1 return into channel mix and within-channel change, using the channel of
      each user's first session.</p>
    </div>
  </details>

  <details class="card appendix">
    <summary>1 · About this dataset <span class="appendix-sub">the store, the export, the events used</span></summary>
    <div class="appendix-body">
      <div class="about-grid">
        <div>
          <strong class="about-h">Business</strong>
          <strong>Google Merchandise Store</strong> (<a href="https://shop.googlemerchandisestore.com" target="_blank" rel="noopener">shop.googlemerchandisestore.com</a>):
          B2C e-commerce selling Google-branded merchandise — apparel, accessories and stationery.
        </div>
        <div>
          <strong class="about-h">Dataset</strong>
          {% if IS_PUBLIC_SAMPLE %}Google's public obfuscated GA4 export on BigQuery{% else %}GA4 BigQuery export{% endif %}
          (<code>{{ DATASET }}</code>) · {{ date_label }} · {{ total_sessions|fmt(',') }} sessions ·
          {{ unique_users|fmt(',') }} users.
          {% if IS_PUBLIC_SAMPLE %}Absolute numbers are illustrative; rates, funnel patterns and the method are valid.{% endif %}
        </div>
        <div>
          <strong class="about-h">Events analysed</strong>
          <code>session_start</code> · <code>page_view</code> · <code>view_item</code> · <code>add_to_cart</code> ·
          <code>begin_checkout</code> · <code>purchase</code>, from the raw event stream (nested
          <code>event_params</code> and <code>items</code>, unnested in SQL).
        </div>
      </div>
    </div>
  </details>

  <details class="card appendix">
    <summary>How this applies to B2B SaaS <span class="appendix-sub">the same funnel and retention logic on product events</span></summary>
    <div class="appendix-body">
      <table class="saas-table">
        <thead>
          <tr><th>E-Commerce Event</th><th>B2B SaaS Equivalent</th><th>Metric</th><th>This Analysis</th></tr>
        </thead>
        <tbody>
          <tr><td>session_start</td><td>User login / app open</td><td>DAU / session volume</td><td class="rate">{{ total_sessions|fmt(',') }} sessions</td></tr>
          <tr><td>view_item</td><td>Feature discovery — reaching a core feature</td><td>Feature reach rate</td><td class="rate">{{ view_rate|fmt('.1f') }}% of sessions</td></tr>
          <tr><td>add_to_cart</td><td>Feature first use — attempting the core action</td><td>Activation attempt rate</td><td class="rate">{{ shoppers_atc|fmt('.1f') }}% of sessions that saw products</td></tr>
          <tr><td>begin_checkout</td><td>Core workflow started — e.g. creating a first record</td><td>Workflow start rate</td><td class="rate">{{ funnel_df.loc[3, 'step_cvr']|fmt('.1f') }}% step-over-step</td></tr>
          <tr><td>purchase</td><td>Activation — completing the key value moment</td><td>Activation rate</td><td class="rate">{{ overall_cvr|fmt('.2f') }}% of all sessions</td></tr>
          <tr><td>Week-1 return</td><td>Closest to D7 retention — but calendar-week return (1–13 days), not exactly 7</td><td>Early retention</td><td class="rate">{{ wk1_display }} avg across cohorts</td></tr>
        </tbody>
      </table>
    </div>
  </details>

  <details class="card appendix">
    <summary>How this page is built <span class="appendix-sub">queries, charts, and where the LLM fits</span></summary>
    <div class="appendix-body prose">
      <p><code>generate_dashboard.py</code> runs every query (all SQL lives in <code>queries.py</code>, shared
      with the analysis notebook), computes each number and verdict, and renders this page from Jinja2
      templates. Every figure in the prose comes from the run, so the page stays true when the window or
      dataset changes: set <code>GA4_DATASET</code>, <code>GA4_DATE_START</code> and <code>GA4_DATE_END</code>
      and re-run.</p>
      <p>The product brief below is written separately, in Section 9 of the notebook: the computed results
      and verdicts are sent as JSON to an LLM (Claude, or Gemini as a free alternative), which never sees raw
      events or SQL. The brief is reviewed before it is embedded, and the page flags it as out of date when
      the analysis has moved on since it was written.</p>
      <p class="arch">GA4 BigQuery export → SQL (<code>queries.py</code>) → pandas metrics → Plotly charts + Jinja2 templates → <code>dashboard.html</code><br>
      pandas metrics → notebook §9 → LLM → reviewed brief → appendix below</p>
      <p class="table-note">Python {{ python_version }} · Plotly {{ plotly_version }} · generated {{ generated_date }}</p>
    </div>
  </details>

{% include "partials/appendix_brief.html.j2" %}

</div>

<script>
// Small, dependency-free behaviours; the page is complete without them.
(function () {
  // Revenue opportunity calculator — same arithmetic as the server-rendered values.
  var c = document.getElementById("calc");
  if (c) {
    var n = +c.dataset.sessions, vtp = +c.dataset.vtp, rpp = +c.dataset.rpp, view = +c.dataset.view;
    var lift = document.getElementById("calc-lift"), keep = document.getElementById("calc-keep");
    var fmt = function (v) { return Math.round(v).toLocaleString("en-US"); };
    var update = function () {
      var l = +lift.value, k = +keep.value;
      var orders = Math.round(Math.floor(n * l / 100) * vtp), rev = Math.round(orders * rpp);
      document.getElementById("calc-lift-out").textContent = l;
      document.getElementById("calc-keep-out").textContent = k;
      document.getElementById("calc-view").textContent = view.toFixed(1) + "% → " + (view + l).toFixed(1) + "%";
      document.getElementById("calc-orders").textContent = "~" + fmt(orders * k / 100) + " extra orders";
      document.getElementById("calc-rev").innerHTML = "~<strong>$" + fmt(rev * k / 100) + "</strong> at $" +
        rpp.toFixed(2) + " per funnel purchase. Planning range at 50–100% of today's rate: <strong>$" +
        fmt(rev * 0.5) + "–$" + fmt(rev) + "</strong>.";
    };
    lift.addEventListener("input", update); keep.addEventListener("input", update);
  }
  // Sortable tables: click a header; cells sort on their data-v value.
  document.querySelectorAll("table.sortable").forEach(function (table) {
    table.querySelectorAll("th").forEach(function (th, col) {
      th.tabIndex = 0; th.title = "Sort by this column";
      var sort = function () {
        var asc = th.dataset.dir !== "asc";
        table.querySelectorAll("th").forEach(function (h) { delete h.dataset.dir; });
        th.dataset.dir = asc ? "asc" : "desc";
        var body = table.tBodies[0], rows = Array.prototype.slice.call(body.rows);
        rows.sort(function (a, b) {
          var x = a.cells[col].dataset.v, y = b.cells[col].dataset.v;
          var nx = parseFloat(x), ny = parseFloat(y);
          var d = (isNaN(nx) || isNaN(ny)) ? String(x).localeCompare(String(y)) : nx - ny;
          return asc ? d : -d;
        });
        rows.forEach(function (r) { body.appendChild(r); });
      };
      th.addEventListener("click", sort);
      th.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); sort(); } });
    });
  });
  // A link to a collapsed appendix block opens it.
  var openTarget = function () {
    var el = location.hash && document.getElementById(location.hash.slice(1));
    if (el && el.tagName === "DETAILS") el.open = true;
  };
  window.addEventListener("hashchange", openTarget); openTarget();
})();
</script>
</body>
</html>
